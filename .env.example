# ============================================================
# SecLog-Agent 环境变量模板
# 复制为 .env 后填写；.env 已被 .gitignore 排除，禁止提交
# ============================================================

# ---------- 数据目录 ----------
# 服务器上 ClickHouse / Qdrant 的持久化根目录（需在数据盘，勿放系统盘）
SECLOG_DATA_ROOT=/vol4/seclog

# ---------- ClickHouse ----------
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=log_ai
CLICKHOUSE_USER=seclog
# 生成方式：openssl rand -base64 24
CLICKHOUSE_PASSWORD=
CLICKHOUSE_FULL_CHAIN_TABLE=log_ai.full_chain_logs

# ---------- Qdrant ----------
QDRANT_URL=http://127.0.0.1:6333
# 仅当 Qdrant 开启 api_key 鉴权时填写
QDRANT_API_KEY=
QDRANT_KNOWLEDGE_COLLECTION=security_knowledge
QDRANT_CASE_COLLECTION=verified_cases

# ---------- SecLog API ----------
SECLOG_API_PORT=18000
API_BIND_HOST=0.0.0.0
API_BIND_PORT=8000
# 恒脑平台调用 MCP/API 时携带的内部令牌；生成方式同上，留空表示不校验（仅限内网）
API_INTERNAL_TOKEN=
# 公网隧道主域名（用于 MCP 侧 Host 白名单校验，不含协议）
SECLOG_PUBLIC_HOST=

# ---------- 公网隧道（natfrp） ----------
# 隧道令牌与隧道 ID 由 natfrp 控制台下发，仅填在此处，禁止写入代码
NATFRP_TOKEN=
NATFRP_TUNNEL_ID=

# ---------- 抓包与 Zeek ----------
# 抓包网卡，留空表示自动探测默认路由网卡
CAPTURE_IFACE=
CAPTURE_FILTER=tcp port 80 or tcp port 443
